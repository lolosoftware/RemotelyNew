# syntax=docker/dockerfile:1.19
# Build from a complete Utilities/Build-Release.ps1 output, not the source checkout.
FROM mcr.microsoft.com/dotnet/aspnet:10.0
LABEL org.opencontainers.image.source="https://github.com/lolosoftware/RemotelyNew"
RUN apt-get update && apt-get install --yes --no-install-recommends curl libfontconfig1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Keep unchanged, signed agents reusable when only the server is patched.
# Numeric app UID/GID permits this linked layer to be independent of /etc/passwd.
COPY --link --chown=1654:1654 Server/wwwroot/Content/ ./wwwroot/Content/
COPY --exclude=wwwroot/Content --exclude=Server/wwwroot/Content --chown=app:app Server/ ./
RUN mkdir -p /app/AppData && chown app:app /app/AppData
ENV ASPNETCORE_HTTP_PORTS=8080 ASPNETCORE_ENVIRONMENT=Production Remotely_ApplicationOptions__DbProvider=SQLite
ENV Remotely_ConnectionStrings__SQLite="Data Source=/app/AppData/Remotely.db"
USER app
EXPOSE 8080
VOLUME ["/app/AppData"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD \
    port="${ASPNETCORE_HTTP_PORTS:-8080}"; \
    host="${AllowedHosts:-localhost}"; \
    host="${host%%;*}"; \
    if [ "$host" = '*' ] || [ -z "$host" ]; then host=localhost; fi; \
    curl --fail --header "Host: $host" "http://localhost:${port%%;*}/api/healthcheck" || exit 1
ENTRYPOINT ["dotnet", "Remotely_Server.dll"]
